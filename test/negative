#!/usr/bin/env bash
# Fixture: none of SC9001-SC9004 must fire on these patterns.

# Taint-suffixed variable properly quoted: SC9001 silent.
var_=foo
echo "$var_"

# Cmdsub assigned to a taint-suffixed variable: SC9002 silent.
content_=$(cat /etc/hostname)

# Cmdsub allowlisted command (hostname): SC9002 silent.
host=$(hostname)

# Non-taint variable used unquoted under IFS/noglob: SC9003 silent.
plain=hello
echo $plain

# List suffix without '_' taint suffix: SC9004 silent.
# Also SC9008 silent (List + string value = correct §3 form: IFS-serialized string).
hostList=foo

# SC9005-silent: string emptiness and file/path tests still belong in [[ ]].
x=
[[ -z $x ]] && echo empty
[[ -f /etc/hostname ]] && echo file
[[ $x == foo ]] && echo eq
# Arithmetic form is the recommended replacement.
rc=$?
(( rc == 0 )) && echo ok

# SC9006-silent: inclusive forms and unrelated names.
allowlist=()
denylistFn() { :; }
neutral=hello

# SC9006-comments-silent: comment using inclusive forms only (#7739).
# prefer the allowlist / denylist terminology
echo ok

# SC9007-silent: docstring's first word matches the function name.

# docfn frobs the input
docfn() { :; }

# Function with no docstring at all: also silent (nothing to validate).

bareFn() { :; }

# SC9008-silent: plural-noun suffix used for arrays (the correct §3 form).
octopi=(inky blinky pinky clyde)
widgets=("$@")

# SC9009-silent: init at declaration (the §6 canonical form).

bar9009a() {
    local items=()
    items+=(a b c)
    echo "${items[@]}"
}
bar9009a

# SC9009-silent: mapfile is an always-init populating command.

bar9009b() {
    local hostnames
    mapfile -t hostnames < /etc/hostname
    echo "${hostnames[@]}"
}
bar9009b

# SC9009-silent: nameref exception (no init makes sense).

bar9009c() {
    local -n REF=$1
    REF=value
}

# SC9001/SC9002 integer-typed exception (#36870).
# Bash coerces every assignment to a `-i`-typed variable to an integer
# (failed coercion yields 0); the IFS-splitting and captured-newline
# hazards the taint convention guards against cannot apply, so neither
# SC9001 nor SC9002 should fire on `-i` declared variables. Reads in
# these blocks are UNQUOTED (so SC9010/SC9003 stay silent in this
# discipline-absent file — the partition rule for SC9003/SC9010 is
# tested elsewhere).

# SC9002-silent below: same-line cmdsub init under `local -i`.

bar9002i_a() {
    local -i count=$(nproc)
    (( count > 0 )) && return 0
}

# SC9002-silent below: later cmdsub assignment to a previously `-i`
# declared variable in scope.

bar9002i_b() {
    local -i n=0
    n=$(nproc)
    (( n > 0 )) && return 0
}

# SC9002-silent below: `declare -i` at top level (script-scope visibility).

declare -i topInt=$(nproc)
(( topInt > 0 )) && :

# SC9002-silent below: bundled flag set containing `i` (`-ir`).

bar9002i_c() {
    local -ir frozen=$(nproc)
    (( frozen > 0 )) && return 0
}

# SC9001-silent below: `-i`-typed var read unquoted (`-i` protects from
# IFS splitting; per SC9011 these are no longer `_`-suffixed -- that
# residue was itself the SC9011 antipattern, fixed here rather than
# routed around).

bar9001i_a() {
    local -i rc=0
    rc=$?
    echo $rc
}

# SC9001-silent below: arithmetic-assignment site composed with an
# unquoted later read of the `-i`-typed var.

bar9001i_b() {
    local -i parallel=0
    (( parallel = $(nproc 2>/dev/null || echo 4) ))
    echo $parallel
}

# SC9011-silent: bare declaration, even with only-later-safe-writes --
# emptiness is reachable at declaration (R1/R2 findings).

bar9011a() {
    local mode_
    if [[ $1 ]]; then
        mode_="a"
    else
        mode_="b"
    fi
    echo "$mode_"
}
bar9011a x

# SC9011-silent: bare `-i` declaration -- also NOT guaranteed non-empty
# (R2 finding, empirically verified: an unassigned `-i` local expands empty).

bar9011b() {
    local -i count_
    count_=5
    echo "$count_"
}
bar9011b

# SC9011-silent: command-substitution and arithmetic-expansion initializers
# are not provably-safe literals.

bar9011c() {
    local x_=$(echo no)
    echo "$x_"
}
bar9011c

bar9011d() {
    local x_=$((1+1))
    echo "$x_"
}
bar9011d

# SC9011-silent: `+=` anywhere in scope disqualifies.

bar9011e() {
    local x_="no"
    x_+="more"
    echo "$x_"
}
bar9011e

# SC9011-silent: escape/unknown-mutator disqualifier -- a bare-name
# occurrence as a command argument conservatively disqualifies (also
# covers read/printf -v/mapfile targets, the same AST shape).

bar9011f() {
    local x_="yes"
    mycustomsetter x_ ""
    echo "$x_"
}

bar9011g() {
    local x_="no"
    read -r x_
    echo "$x_"
}

# SC9011-silent: eval/source/. anywhere in scope disqualifies every
# candidate, including recursive `builtin`/`command` wrapper forms.

bar9011h() {
    local x_="no"
    eval 'x_=yes'
    echo "$x_"
}

bar9011i() {
    local x_="no"
    command builtin eval 'x_=yes'
    echo "$x_"
}
