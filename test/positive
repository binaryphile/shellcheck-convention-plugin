#!/usr/bin/env bash
# Fixture: each block must trip exactly the matching SC9xxx convention check.

# IFS+noglob discipline established at file top so SC9003's "quoting
# unnecessary" advice is sound (per #17958 discipline-gating). Without
# this, SC9003 would be silent and SC9010 would fire on the SC9003
# block below — see test/positive-no-discipline for the SC9010 case.
IFS=$'\n'
set -o noglob

# SC9001: taint-suffix variable used unquoted in a splitting context.
var_=$(printf foo)
echo $var_

# SC9002: command substitution assigned to a non-taint variable; cat is not allowlisted.
content=$(cat /etc/hostname)

# SC9003: non-taint variable quoted under IFS/noglob (quoting is unnecessary).
plain=hello
echo "$plain"

# SC9004: '_' taint suffix and 'List' suffix are mutually exclusive.
hostList_=foo

# SC9004: '_' taint suffix and 'Lists' suffix are mutually exclusive.
hostLists_=(a b)

# SC9005: numeric comparison in [[ ]]; bash-style-guide §7 says use (( )).
rc=$?
[[ $rc -eq 0 ]] && echo ok

# SC9006: identifier contains the legacy whitelist/blacklist substring.
whitelist=()
blacklistFn() { :; }

# SC9006-comments: legacy term in comment text (#7739).
# avoid using whitelist; prefer allowlist instead
echo ok

# SC9007: docstring above function doesn't start with the function name.
# Helper that frobs the input
docfn() { :; }

# SC9008: *List suffix used with array initializer; *List should be IFS-string (§3).
xList=(a b c)

# SC9013: *Lists suffix used with scalar initializer; *Lists should be a true array (§3).
xLists=foo

# SC9009: array declared without init, first materialized via += (§6).
foo9009() {
    local items
    items+=(a b c)
    echo "${items[@]}"
}
foo9009

# SC9011: _-suffixed local initialized to and only ever reassigned a
# non-empty, IFS-free literal -- the suffix is unwarranted (era#80703 anchor).
foo9011() {
    local taskSeen_="no"
    taskSeen_="yes"
    echo "$taskSeen_"
}
foo9011

# SC9011: read -r NAME <<< "literal" / printf -v NAME "literal" are
# provably-safe writes when the literal clears every guard (default fd,
# single line, default IFS, non-empty, IFS-free, NUL-free, no leading
# hyphen for printf) -- #86907.
foo9011j() {
    local x_="no"
    read -r x_ <<< "yes"
    echo "$x_"
}
foo9011j

foo9011k() {
    local x_="no"
    printf -v x_ "yes"
    echo "$x_"
}
foo9011k

foo9011l() {
    local x_="no"
    <<< "yes" read -r x_
    echo "$x_"
}
foo9011l

# SC9012: double-quoted string literal with no expansion and no embedded
# single quote should be single-quoted (#69103).
echo "hello"

# SC9014: cross-scope out-param call-site argument collides with the
# callee's own local (bash-style-guide "Cross-scope return variables" --
# #26606, redesigned #126151 from caller-casing to actual collision
# detection -- the original 2018 invariant is that the CALLEE namespaces
# its own locals, not that the caller must use special casing).

foo9014() {
  local -n REF=$1
  REF=x
}
foo9014 REF
